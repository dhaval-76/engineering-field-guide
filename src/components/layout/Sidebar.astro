---
import Icon from '~/components/Icon.astro';
import { getNav } from '~/lib/nav';
import { topicUrl, trackUrl } from '~/lib/url';

interface Props {
  current?: { track?: string; topic?: string } | undefined;
}
const { current } = Astro.props;
const nav = await getNav();
---

<div class="scrim" data-nav-close hidden></div>
<aside id="sidebar" class="sidebar" aria-label="Topics">
  <div class="sidebar-inner">
    <nav>
      <ol class="tracks">
        {nav.map(({ track, topics }) => {
          const open = current?.track === track.id;
          return (
            <li>
              <details open={open}>
                <summary class:list={{ active: open }}>
                  <Icon name={track.data.icon} />
                  <span>{track.data.title}</span>
                  <span class="count" data-track-count={track.id} data-total={topics.length}>
                    {topics.length}
                  </span>
                </summary>
                <ol class="topics">
                  <li>
                    <a
                      class="overview"
                      href={trackUrl(track.id)}
                      aria-current={open && !current?.topic ? 'page' : undefined}
                    >
                      Overview
                    </a>
                  </li>
                  {topics.map((t) => (
                    <li>
                      <a
                        href={topicUrl(t.id)}
                        data-topic-link={t.id}
                        aria-current={current?.topic === t.id ? 'page' : undefined}
                      >
                        <span class="dot" aria-hidden="true" />
                        {t.data.title}
                      </a>
                    </li>
                  ))}
                </ol>
              </details>
            </li>
          );
        })}
      </ol>
    </nav>
  </div>
</aside>

<style>
  .sidebar {
    position: fixed;
    inset: var(--header-h) auto 0 0;
    z-index: 35;
    width: min(320px, 86vw);
    background: var(--bg);
    border-right: 1px solid var(--rule);
    transform: translateX(-100%);
    transition: transform 0.2s ease;
    visibility: hidden;
  }
  :global(html[data-nav='open']) .sidebar {
    transform: none;
    visibility: visible;
  }
  .scrim {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: 34;
    background: rgb(0 0 0 / 0.35);
  }
  .sidebar-inner {
    height: 100%;
    overflow-y: auto;
    padding: 16px 12px 48px;
    overscroll-behavior: contain;
  }
  @media (min-width: 960px) {
    .sidebar {
      position: sticky;
      top: var(--header-h);
      height: calc(100vh - var(--header-h));
      width: auto;
      transform: none;
      visibility: visible;
      border-right: 0;
      background: transparent;
      transition: none;
    }
    .sidebar-inner {
      padding: 32px 0 48px;
    }
    .scrim {
      display: none;
    }
    :global(html[data-focus='on']) .sidebar {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sidebar {
      transition: none;
    }
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 8px;
    border-radius: var(--radius);
    cursor: pointer;
    font-size: 0.9375rem;
    font-weight: 560;
    color: var(--ink-2);
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: var(--bg-sunken);
    color: var(--ink);
  }
  summary.active {
    color: var(--ink);
  }
  summary :global(.icon) {
    color: var(--ink-3);
  }
  summary.active :global(.icon) {
    color: var(--accent);
  }
  .count {
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .topics {
    margin: 2px 0 10px 17px;
    padding-left: 12px;
    border-left: 1px solid var(--rule);
  }
  .topics a {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 4px 8px;
    border-radius: var(--radius);
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .topics a:hover {
    color: var(--ink);
    background: var(--bg-sunken);
  }
  .topics a[aria-current='page'] {
    color: var(--accent-ink);
    background: var(--accent-soft);
    font-weight: 560;
  }
  .overview {
    font-style: italic;
  }
  .dot {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 50%;
    border: 1px solid var(--rule-strong);
    transform: translateY(-1px);
  }
  :global([data-done]) > .dot {
    background: var(--ok);
    border-color: var(--ok);
  }
</style>
