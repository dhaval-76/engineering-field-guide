---
import type { TocHeading } from '~/lib/qa';

interface Props {
  headings: TocHeading[];
}
const headings = Astro.props.headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{headings.length > 1 && (
  <nav class="toc" data-toc aria-label="On this page" data-pagefind-ignore>
    <p class="eyebrow">On this page</p>
    <ol>
      {headings.map((h) => (
        <li class={`d${h.depth}`}>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .toc {
    font-size: 0.875rem;
  }
  .eyebrow {
    margin: 0 0 8px;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--rule);
  }
  li a {
    display: block;
    padding: 4px 12px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--ink-3);
    text-decoration: none;
    line-height: 1.4;
  }
  li.d3 a {
    padding-left: 24px;
  }
  li a:hover {
    color: var(--ink);
  }
  li a[aria-current='true'] {
    color: var(--accent-ink);
    border-left-color: var(--accent);
  }
</style>
