---
interface Props {
  title?: string;
}
const { title = 'Key takeaways' } = Astro.props;
---

<section class="takeaways" aria-label={title}>
  <p class="label">{title}</p>
  <slot />
</section>

<style>
  .takeaways {
    margin: 2em 0;
    padding: 18px 20px;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
  }
  .label {
    margin: 0 0 8px;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 560;
  }
  .takeaways :global(ul) {
    margin: 0;
    padding-left: 1.2em;
  }
  .takeaways :global(li::marker) {
    color: var(--accent);
  }
</style>
