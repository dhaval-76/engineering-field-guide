---
/**
 * Small build-time SVG charts. No client JS.
 * - line: series of numbers over shared x labels (optionally log-scaled y)
 * - bar: horizontal bars, good for comparing magnitudes (latency numbers, throughput).
 *   Bars are HTML, not SVG, so labels wrap and stay readable on a phone.
 */
interface Series {
  name: string;
  values: number[];
  tone?: Tone;
}
type Tone = 'accent' | 'info' | 'ok' | 'warn' | 'bad' | 'plum' | 'muted';
interface Props {
  type: 'line' | 'bar';
  title: string;
  caption?: string;
  /** line: x-axis labels */
  x?: (string | number)[];
  series?: Series[];
  /** bar: [label, value, tone?] */
  bars?: [string, number, Tone?][];
  unit?: string;
  log?: boolean;
  yLabel?: string;
}
const {
  type,
  title,
  caption,
  x = [],
  series = [],
  bars = [],
  unit = '',
  log = false,
  yLabel,
} = Astro.props;

const toneVar = (t: Tone | undefined, i: number) => {
  const order: Tone[] = ['accent', 'info', 'ok', 'plum', 'warn', 'bad'];
  const tone = t ?? order[i % order.length]!;
  return tone === 'muted' ? 'var(--ink-3)' : `var(--d-${tone})`;
};
const fmt = (n: number) =>
  n >= 1e9
    ? `${+(n / 1e9).toFixed(1)}B`
    : n >= 1e6
      ? `${+(n / 1e6).toFixed(1)}M`
      : n >= 1e4
        ? `${+(n / 1e3).toFixed(1)}k`
        : n >= 1e3
          ? Math.round(n).toLocaleString('en-US')
          : `${+n.toFixed(2)}`;

// Line chart geometry
// A narrow viewBox keeps tick text readable when the chart is shrunk to a phone screen;
// series are named in the HTML legend rather than at the line ends.
const W = 440,
  H = 280,
  pad = { l: 50, r: 34, t: 24, b: 34 };
const all = series.flatMap((s) => s.values);
// Round the axis up to a "nice" step (1, 2 or 5 × 10^k) so ticks read 0, 250, 500…
const niceStep = (range: number, count: number) => {
  const raw = range / count;
  const mag = 10 ** Math.floor(Math.log10(raw));
  const f = raw / mag;
  return (f <= 1 ? 1 : f <= 2 ? 2 : f <= 2.5 ? 2.5 : f <= 5 ? 5 : 10) * mag;
};
const dataMax = Math.max(1, ...all);
const step = niceStep(dataMax, 4);
const yMaxRaw = log ? dataMax : Math.ceil(dataMax / step) * step;
const scaleY = (v: number) => {
  const iw = H - pad.t - pad.b;
  if (log) {
    const max = Math.log10(yMaxRaw);
    return pad.t + iw - (Math.log10(Math.max(v, 1)) / (max || 1)) * iw;
  }
  return pad.t + iw - (v / yMaxRaw) * iw;
};
const scaleX = (i: number) => pad.l + (i / Math.max(1, x.length - 1)) * (W - pad.l - pad.r);
const ticks = log
  ? Array.from({ length: Math.floor(Math.log10(yMaxRaw)) + 1 }, (_, i) => 10 ** i)
  : Array.from({ length: Math.round(yMaxRaw / step) + 1 }, (_, i) => i * step);

// Bar chart geometry: width as a percentage of the track
const barMax = Math.max(1, ...bars.map((b) => b[1]));
const barPct = (v: number) => {
  const f = log ? Math.log10(Math.max(v, 1)) / Math.log10(barMax) : v / barMax;
  return Math.max(0.5, f * 100);
};
---

<figure class="chart">
  <p class="title">{title}</p>
  {type === 'line' ? (
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title}>
      {ticks.map((t) => (
        <g>
          <line x1={pad.l} x2={W - pad.r} y1={scaleY(t)} y2={scaleY(t)} class="grid" />
          <text x={pad.l - 8} y={scaleY(t) + 4} class="tick" text-anchor="end">
            {fmt(t)}
          </text>
        </g>
      ))}
      {x.map((label, i) => (
        <text x={scaleX(i)} y={H - pad.b + 20} class="tick" text-anchor="middle">
          {label}
        </text>
      ))}
      {yLabel && (
        <text class="tick" x={pad.l - 8} y={12} text-anchor="end">
          {yLabel}
        </text>
      )}
      {series.map((s, si) => {
        const pts = s.values.map((v, i) => `${scaleX(i)},${scaleY(v)}`).join(' ');
        return (
          <g style={`--c:${toneVar(s.tone, si)}`}>
            <polyline points={pts} class="line" />
            {s.values.map((v, i) => (
              <circle cx={scaleX(i)} cy={scaleY(v)} r="3" class="pt">
                <title>{`${s.name}: ${fmt(v)}${unit} at ${x[i] ?? i}`}</title>
              </circle>
            ))}
          </g>
        );
      })}
    </svg>
  ) : (
    <ul class="bars">
      {bars.map(([label, v, tone]) => (
        <li style={`--c:${toneVar(tone, 0)}`}>
          <span class="label">{label}</span>
          <span class="track">
            <span class="bar" style={`width:${barPct(v)}%`} />
            <span class="value">
              {fmt(v)}
              {unit}
            </span>
          </span>
        </li>
      ))}
    </ul>
  )}
  {type === 'line' && series.length > 0 && (
    <ul class="legend">
      {series.map((s, si) => (
        <li style={`--c:${toneVar(s.tone, si)}`}>{s.name}</li>
      ))}
    </ul>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .chart {
    margin: 1.8em 0;
    padding: 16px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--d-bg);
    overflow-x: auto;
  }
  .title {
    margin: 0 0 8px;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  svg {
    display: block;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    height: auto;
    font-family: var(--font-sans);
  }
  .grid {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .tick {
    fill: var(--ink-3);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .line {
    fill: none;
    stroke: var(--c);
    stroke-width: 2.2;
    stroke-linejoin: round;
  }
  .pt {
    fill: var(--d-bg);
    stroke: var(--c);
    stroke-width: 2;
  }
  .bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .bars li {
    display: grid;
    gap: 3px;
  }
  .label {
    font-size: 0.8125rem;
    color: var(--ink-2);
    line-height: 1.35;
  }
  .track {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-right: 4.5em;
  }
  .bar {
    height: 14px;
    border-radius: 3px;
    background: var(--c);
    opacity: 0.85;
    flex: none;
  }
  .value {
    margin-right: -4.5em;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .bars li {
      grid-template-columns: minmax(140px, 34%) 1fr;
      align-items: center;
      gap: 12px;
    }
    .label {
      text-align: right;
    }
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .legend li::before {
    content: '';
    width: 14px;
    height: 3px;
    border-radius: 2px;
    background: var(--c);
  }
  figcaption {
    margin-top: 8px;
    font-size: 0.875rem;
    color: var(--ink-3);
  }
</style>
