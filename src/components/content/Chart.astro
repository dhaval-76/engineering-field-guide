---
/**
 * Small build-time SVG charts. No client JS.
 * - line: series of numbers over shared x labels (optionally log-scaled y)
 * - bar: horizontal bars, good for comparing magnitudes (latency numbers, throughput)
 */
interface Series {
  name: string;
  values: number[];
  tone?: Tone;
}
type Tone = 'accent' | 'info' | 'ok' | 'warn' | 'bad' | 'plum' | 'muted';
interface Props {
  type: 'line' | 'bar';
  title: string;
  caption?: string;
  /** line: x-axis labels */
  x?: (string | number)[];
  series?: Series[];
  /** bar: [label, value, tone?] */
  bars?: [string, number, Tone?][];
  unit?: string;
  log?: boolean;
  yLabel?: string;
}
const {
  type,
  title,
  caption,
  x = [],
  series = [],
  bars = [],
  unit = '',
  log = false,
  yLabel,
} = Astro.props;

const toneVar = (t: Tone | undefined, i: number) => {
  const order: Tone[] = ['accent', 'info', 'ok', 'plum', 'warn', 'bad'];
  const tone = t ?? order[i % order.length]!;
  return tone === 'muted' ? 'var(--ink-3)' : `var(--d-${tone})`;
};
const fmt = (n: number) =>
  n >= 1e9
    ? `${+(n / 1e9).toFixed(1)}B`
    : n >= 1e6
      ? `${+(n / 1e6).toFixed(1)}M`
      : n >= 1e3
        ? `${+(n / 1e3).toFixed(1)}k`
        : `${+n.toFixed(2)}`;

// Line chart geometry
const W = 640,
  H = 300,
  pad = { l: 56, r: 120, t: 16, b: 40 };
const all = series.flatMap((s) => s.values);
const yMaxRaw = Math.max(1, ...all);
const scaleY = (v: number) => {
  const iw = H - pad.t - pad.b;
  if (log) {
    const max = Math.log10(yMaxRaw);
    return pad.t + iw - (Math.log10(Math.max(v, 1)) / (max || 1)) * iw;
  }
  return pad.t + iw - (v / yMaxRaw) * iw;
};
const scaleX = (i: number) => pad.l + (i / Math.max(1, x.length - 1)) * (W - pad.l - pad.r);
const ticks = log
  ? Array.from({ length: Math.floor(Math.log10(yMaxRaw)) + 1 }, (_, i) => 10 ** i)
  : [0, 0.25, 0.5, 0.75, 1].map((f) => f * yMaxRaw);

// Bar chart geometry
const barMax = Math.max(1, ...bars.map((b) => b[1]));
const BH = 26,
  labelW = 200,
  BW = 640;
const barLen = (v: number) => {
  const avail = BW - labelW - 90;
  if (log) return Math.max(2, (Math.log10(Math.max(v, 1)) / Math.log10(barMax)) * avail);
  return Math.max(2, (v / barMax) * avail);
};
---

<figure class="chart">
  <p class="title">{title}</p>
  {type === 'line' ? (
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title}>
      {ticks.map((t) => (
        <g>
          <line x1={pad.l} x2={W - pad.r} y1={scaleY(t)} y2={scaleY(t)} class="grid" />
          <text x={pad.l - 8} y={scaleY(t) + 4} class="tick" text-anchor="end">
            {fmt(t)}
          </text>
        </g>
      ))}
      {x.map((label, i) => (
        <text x={scaleX(i)} y={H - pad.b + 20} class="tick" text-anchor="middle">
          {label}
        </text>
      ))}
      {yLabel && (
        <text class="tick" x={14} y={pad.t + 6}>
          {yLabel}
        </text>
      )}
      {series.map((s, si) => {
        const pts = s.values.map((v, i) => `${scaleX(i)},${scaleY(v)}`).join(' ');
        const last = s.values.length - 1;
        return (
          <g style={`--c:${toneVar(s.tone, si)}`}>
            <polyline points={pts} class="line" />
            {s.values.map((v, i) => (
              <circle cx={scaleX(i)} cy={scaleY(v)} r="3" class="pt">
                <title>{`${s.name}: ${fmt(v)}${unit} at ${x[i] ?? i}`}</title>
              </circle>
            ))}
            <text x={scaleX(last) + 8} y={scaleY(s.values[last] ?? 0) + 4} class="series">
              {s.name}
            </text>
          </g>
        );
      })}
    </svg>
  ) : (
    <svg viewBox={`0 0 ${BW} ${bars.length * (BH + 10) + 10}`} role="img" aria-label={title}>
      {bars.map(([label, v, tone], i) => (
        <g transform={`translate(0 ${10 + i * (BH + 10)})`} style={`--c:${toneVar(tone, 0)}`}>
          <text x={labelW - 10} y={BH / 2 + 4} class="label" text-anchor="end">
            {label}
          </text>
          <rect x={labelW} y="0" width={barLen(v)} height={BH} rx="3" class="bar" />
          <text x={labelW + barLen(v) + 8} y={BH / 2 + 4} class="value">
            {fmt(v)}
            {unit}
          </text>
        </g>
      ))}
    </svg>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .chart {
    margin: 1.8em 0;
    padding: 16px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--d-bg);
    overflow-x: auto;
  }
  .title {
    margin: 0 0 8px;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 480px;
    height: auto;
    font-family: var(--font-sans);
  }
  .grid {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .tick {
    fill: var(--ink-3);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .line {
    fill: none;
    stroke: var(--c);
    stroke-width: 2.2;
    stroke-linejoin: round;
  }
  .pt {
    fill: var(--d-bg);
    stroke: var(--c);
    stroke-width: 2;
  }
  .series {
    fill: var(--c);
    font-size: 12px;
    font-weight: 600;
  }
  .bar {
    fill: var(--c);
    opacity: 0.85;
  }
  .label {
    fill: var(--ink-2);
    font-size: 12px;
  }
  .value {
    fill: var(--ink);
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  figcaption {
    margin-top: 8px;
    font-size: 0.875rem;
    color: var(--ink-3);
  }
</style>
