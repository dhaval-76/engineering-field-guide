flowchart TD
  U1[Client A] -- WebSocket --> LB[L7 load balancer<br/>long idle timeouts]
  U2[Client B] -- WebSocket --> LB
  U3[Client C] -- SSE --> LB
  LB --> G1[Connection server 1<br/>~100k sockets]
  LB --> G2[Connection server 2]
