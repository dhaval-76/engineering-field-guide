classDiagram
  direction TB
  class Broker {
    +publish(topic, key, payload) long
    +subscribe(topic, group, fromBeginning)
    +poll(topic, group, max) List~Message~
    +commit(topic, group, nextOffset)
    +trim(topic) int
  }
  class Topic {
    -List~Message~ log
    -long baseOffset
    -Map~String,Long~ committed
  }
  class Message {
    +long offset
    +String key
    +String payload
  }
  class Dispatcher {
    -Consumer~Message~ handler
    -int maxAttempts
    +run()
    +stop()
  }
  Broker *-- Topic : many topics
  Topic *-- Message : append-only log
  Dispatcher --> Broker : polls and commits
