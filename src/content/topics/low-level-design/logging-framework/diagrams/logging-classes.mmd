classDiagram
  class LoggerFactory {
    +getLogger(name)$ Logger
    +root()$ Logger
  }
  class Logger {
    -String name
    -Logger parent
    -Level level
    -boolean additive
    +effectiveLevel() Level
    +log(level, message)
  }
  class Appender {
    <<interface>>
    +append(LogEvent)
    +close()
  }
  class Formatter {
    <<interface>>
    +format(LogEvent) String
  }
  class ConsoleAppender
  class RollingFileAppender
  class AsyncAppender {
    -BlockingQueue queue
    -Appender target
  }
  class PatternFormatter
  class JsonFormatter
  LoggerFactory --> Logger : creates and caches
  Logger --> Logger : parent
  Logger "1" o-- "many" Appender
  Appender <|.. ConsoleAppender
  Appender <|.. RollingFileAppender
  Appender <|.. AsyncAppender
  AsyncAppender --> Appender : wraps
  ConsoleAppender --> Formatter
  RollingFileAppender --> Formatter
  Formatter <|.. PatternFormatter
  Formatter <|.. JsonFormatter
