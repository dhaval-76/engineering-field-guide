classDiagram
  direction TB
  class LoggerFactory {
    +getLogger(name)$ Logger
  }
  class Logger {
    -name, level, parent
    +effectiveLevel()
    +log(level, message)
  }
  class Appender {
    <<interface>>
    +append(event)
    Console · RollingFile
  }
  class AsyncAppender {
    -queue
    -target Appender
  }
  class Formatter {
    <<interface>>
    +format(event) String
    Pattern · Json
  }
  LoggerFactory --> Logger : creates, caches
  Logger --> Logger : parent
  Logger o-- Appender : many
  Appender <|.. AsyncAppender
  AsyncAppender --> Appender : wraps
  Appender --> Formatter
