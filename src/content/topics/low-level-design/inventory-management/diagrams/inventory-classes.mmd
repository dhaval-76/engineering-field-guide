classDiagram
  direction TB
  class InventoryService {
    +reserve(order, sku, qty)
    +confirm(reservationId)
    +cancel(reservationId)
    +available(sku) int
  }
  class StockLevel {
    onHand
    reserved
    +available() int
  }
  class Reservation {
    orderId
    warehouse, sku, qty
    expiresAt
  }
  class AllocationStrategy {
    <<interface>>
    +choose(sku, qty)
  }
  class LowStockListener {
    <<interface>>
    +onLowStock(sku)
  }
  InventoryService *-- StockLevel : per site × SKU
  InventoryService *-- Reservation
  AllocationStrategy <-- InventoryService
  LowStockListener <-- InventoryService
