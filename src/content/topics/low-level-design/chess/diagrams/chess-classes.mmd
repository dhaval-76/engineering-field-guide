classDiagram
  direction TB
  class Game {
    -turn
    -history
    +legalMoves(square)
    +play(from, to) Status
    +undo()
  }
  class Board {
    +at(square) Piece
    +isAttacked(square, by)
    +kingOf(color)
  }
  class Move {
    from, to
    moved, captured
    +apply(board)
    +revert(board)
  }
  class Piece {
    <<abstract>>
    color
    +candidateMoves(board, at)
  }
  class Pieces {
    King · Queen · Rook
    Bishop · Knight · Pawn
  }
  Game --> Board
  Game o-- Move : history
  Board o-- Piece : up to 32
  Piece <|-- Pieces
