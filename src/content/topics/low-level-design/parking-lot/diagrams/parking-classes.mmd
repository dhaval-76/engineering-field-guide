classDiagram
  direction TB
  class ParkingLot {
    +park(vehicle) Ticket
    +pay(ticketId, money)
    +exit(ticketId)
  }
  class ParkingSpot {
    floor, size
    +tryOccupy(vehicle) bool
    +release()
  }
  class Ticket {
    entry, status
    +markPaid(money)
  }
  class Vehicle {
    plate, type
  }
  class Policies {
    <<interfaces>>
    SpotSelector → NearestSmallestFit
    PricingPolicy → HourlyWithDailyCap
    SpotListener → DisplayBoard
  }
  ParkingLot *-- ParkingSpot
  ParkingLot o-- Ticket : active
  Ticket --> ParkingSpot
  Ticket --> Vehicle
  Policies <-- ParkingLot : uses
