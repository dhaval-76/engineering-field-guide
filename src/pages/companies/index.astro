---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCompanyIndex } from '~/lib/companies';
import { url } from '~/lib/url';

const companies = (await getCompanyIndex())
  .map((c) => ({ ...c, total: c.items.reduce((n, i) => n + (i.reports ?? 1), 0) }))
  .sort((a, b) => b.total - a.total || a.name.localeCompare(b.name));
---

<BaseLayout
  title="Companies"
  description="Interview topics grouped by company, counted from public interview reports, with sources."
>
  <div class="wrap">
    <h1>Companies</h1>
    <p class="lede">
      Which topics come up at which companies, counted from public interview write-ups (2024–2026)
      and linked to the original posts. Reports show what some candidates were asked — useful for
      prioritising, not a guarantee.
    </p>
    {companies.length === 0 && <p class="lede">No company data yet.</p>}
    <ul>
      {companies.map((c) => (
        <li>
          <a href={url(`companies/${c.slug}/`)}>{c.name}</a>
          <span>{c.items.length} topics</span>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 860px;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 560;
    font-size: var(--step-4);
    margin: 0;
  }
  .lede {
    color: var(--ink-2);
    max-width: var(--measure);
  }
  ul {
    list-style: none;
    padding: 0;
    columns: 3 220px;
    column-gap: 32px;
    margin-top: 24px;
  }
  li {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 0;
    border-bottom: 1px solid var(--rule);
    break-inside: avoid;
  }
  span {
    color: var(--ink-3);
    font-size: 0.875rem;
  }
</style>
