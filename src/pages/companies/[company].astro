---
import CodeTabs from '~/components/content/CodeTabs.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCompanyIndex, SECTIONS, sectionOfTopic } from '~/lib/companies';
import { md } from '~/lib/markdown';
import { getFlatTopics, getNav } from '~/lib/nav';
import { topicUrl, url } from '~/lib/url';

export async function getStaticPaths() {
  const companies = await getCompanyIndex();
  return companies.map((c) => ({ params: { company: c.slug }, props: { company: c } }));
}

const { company } = Astro.props;
const nav = await getNav();
const trackTitle = new Map(nav.map((n) => [n.track.id, n.track.data.short]));
const titles = new Map((await getFlatTopics()).map((t) => [t.id, t.data.title]));

const overview = await Promise.all(company.overview.map((o) => md(o)));
const questions = await Promise.all(
  company.questions.map(async (q) => ({
    ...q,
    topicId: q.topic.id,
    problemHtml: await md(q.problem),
    solutionHtml: await md(q.solution),
  })),
);
const tagged = await Promise.all(
  company.items
    .filter((i) => i.kind === 'question' || i.kind === 'follow-up')
    .map(async (i) => ({ ...i, answerHtml: i.answer ? await md(i.answer) : '' })),
);
const taggedTopics = company.items.filter((i) => i.kind === 'topic');
const reported = company.items
  .filter((i) => i.kind === 'reported')
  .sort((a, b) => (b.reports ?? 0) - (a.reports ?? 0) || a.text.localeCompare(b.text));

const sections = SECTIONS.map((s) => ({
  ...s,
  // A stable sort, so questions with the same number of reports keep their curated order.
  questions: questions
    .filter((q) => q.section === s.id)
    .sort((a, b) => b.reports.length - a.reports.length),
  tagged: tagged.filter((i) => sectionOfTopic(i.topicId) === s.id),
  taggedTopics: taggedTopics.filter((i) => sectionOfTopic(i.topicId) === s.id),
  reported: reported.filter((i) => sectionOfTopic(i.topicId) === s.id),
})).filter(
  (s) => s.questions.length + s.tagged.length + s.taggedTopics.length + s.reported.length > 0,
);
const count = (s: (typeof sections)[number]) => s.questions.length + s.tagged.length;
/** When a question was reported, for the folded row: "2026", "2025, 2026" or "2021–2025". */
const asked = (years: number[]) => {
  const ys = [...new Set(years)].sort();
  if (!ys.length) return '';
  return ys.length <= 2 ? ys.join(', ') : `${ys[0]}–${ys[ys.length - 1]}`;
};
const summaryOf = (s: (typeof sections)[number]) => {
  const n = count(s);
  if (n > 0) return `${n} question${n === 1 ? '' : 's'}`;
  const t = s.taggedTopics.length + s.reported.length;
  return `${t} topic${t === 1 ? '' : 's'}`;
};
---

<BaseLayout
  title={`${company.name} interview questions`}
  description={`Questions reported in ${company.name} interviews by section, written as interview problems, with solutions, links to explanations and the original reports.`}
>
  <div class="wrap">
    <p class="eyebrow">
      <a href={url('companies/')}>Companies</a>
    </p>
    <h1>{company.name}</h1>
    <p class="lede">
      {questions.length > 0
        ? 'Questions candidates reported in public interview write-ups, written the way an interviewer would ask them. Try each one before you open its solution. The most reported come first in every section.'
        : 'Topics and questions candidates mentioned in public interview write-ups.'}{' '}
      Reports show what came up for some candidates, not a fixed question list.
    </p>
    {company.listSource && (
      <p class="lede small">
        A <span class="lw">LeetCode list</span> label means the problem is also on{' '}
        <a href={company.listSource} rel="nofollow noopener" target="_blank">
          a community copy of LeetCode's {company.name} tags
        </a>
        , with the most recent period it appears in. Those tags come from LeetCode users and have no
        dates or rounds, so they are shown separately from reports. Questions found only there come
        after the reported ones.
      </p>
    )}

    {overview.length > 0 && (
      <section class="overview prose" aria-label="What the rounds look like">
        <h2>What the rounds look like</h2>
        <ul>
          {overview.map((o) => (
            <li set:html={o} />
          ))}
        </ul>
      </section>
    )}

    <nav class="jump" aria-label="Sections">
      {sections.map((s) => (
        <a href={`#${s.id}`}>
          {s.label}
          {count(s) > 0 && <span class="n">{count(s)}</span>}
        </a>
      ))}
    </nav>

    {sections.map((s) => (
      <details class="sec" id={s.id}>
        <summary>
          <h2>{s.label}</h2>
          <span class="sec-n">{summaryOf(s)}</span>
        </summary>

        {s.questions.map((q, i) => (
          <details class="cq" id={`q-${q.id}`}>
            <summary>
              <span class="i">{i + 1}</span>
              <span class="t">{q.title}</span>
              <span class="meta">
                {q.difficulty && <span class={`d ${q.difficulty}`}>{q.difficulty}</span>}
                {q.reports.length > 0 && (
                  <span class="y">asked {asked(q.reports.map((r) => r.year))}</span>
                )}
                {q.reports.length > 1 && <span class="r">{q.reports.length} reports</span>}
                {q.listWindow && (
                  <span class="lw">
                    LeetCode list{q.listWindow === 'all time' ? '' : `: ${q.listWindow}`}
                  </span>
                )}
              </span>
            </summary>
            <div class="body">
              <div class="prose" set:html={q.problemHtml} />
              {q.examples.map((e, n) => (
                <div class="ex">
                  <p class="tag">Example{q.examples.length > 1 ? ` ${n + 1}` : ''}</p>
                  <div class="io">
                    <p>
                      <b>Input:</b> <code>{e.input}</code>
                    </p>
                    <p>
                      <b>Output:</b> <code>{e.output}</code>
                    </p>
                    {e.explanation && (
                      <p class="why">
                        <b>Why:</b> {e.explanation}
                      </p>
                    )}
                  </div>
                </div>
              ))}
              {q.constraints.length > 0 && (
                <>
                  <p class="tag">Constraints</p>
                  <ul class="cons">
                    {q.constraints.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                </>
              )}
              <p class="links">
                {q.leetcode && (
                  <a
                    href={`https://leetcode.com/problems/${q.leetcode}/`}
                    rel="nofollow noopener"
                    target="_blank"
                  >
                    Practise on LeetCode ↗
                  </a>
                )}
                {q.reports.map((r, n) => (
                  <a href={r.source} rel="nofollow noopener" target="_blank">
                    Report{q.reports.length > 1 ? ` ${n + 1}` : ''} ({r.year}) ↗
                  </a>
                ))}
                {q.listWindow && company.listSource && (
                  <a href={company.listSource} rel="nofollow noopener" target="_blank">
                    On the LeetCode list (
                    {q.listWindow === 'all time' ? 'all time' : `last ${q.listWindow}`}) ↗
                  </a>
                )}
              </p>

              <details class="sol">
                <summary>Show solution</summary>
                <div class="sol-body">
                  <div class="prose" set:html={q.solutionHtml} />
                  {q.complexity && (
                    <p class="cx">
                      <strong>Cost:</strong> {q.complexity}
                    </p>
                  )}
                  {q.code && <CodeTabs id={q.code} title={q.title} />}
                  <p class="links">
                    <a href={topicUrl(q.topicId)}>Explained in {titles.get(q.topicId)}</a>
                  </p>
                </div>
              </details>
            </div>
          </details>
        ))}

        {s.tagged.map((it) => (
          <details class="cq">
            <summary>
              <span class="t">{it.text}</span>
              {it.year && (
                <span class="meta">
                  <span class="y">asked {it.year}</span>
                </span>
              )}
            </summary>
            <div class="body">
              <p class="links">
                <a href={it.source} rel="nofollow noopener" target="_blank">
                  Report{it.year ? ` (${it.year})` : ''} ↗
                </a>
              </p>
              <details class="sol">
                <summary>Show answer</summary>
                <div class="sol-body">
                  <div class="prose" set:html={it.answerHtml} />
                  <p class="links">
                    <a href={it.url}>Explained in {it.topicTitle}</a>
                  </p>
                </div>
              </details>
            </div>
          </details>
        ))}

        {s.taggedTopics.length > 0 && (
          <ul class="tagged">
            {s.taggedTopics.map((it) => (
              <li>
                <a href={it.url}>{it.text}</a>
                <span class="muted">
                  {it.year && `${it.year} · `}
                  <a href={it.source} rel="nofollow noopener" target="_blank">
                    report ↗
                  </a>
                </span>
              </li>
            ))}
          </ul>
        )}

        {s.reported.length > 0 && (
          <>
            <h3>Topics mentioned in reports</h3>
            <div class="scroll">
              <table>
                <thead>
                  <tr>
                    <th>Topic</th>
                    <th>Track</th>
                    <th class="num">Reports</th>
                    <th class="num">Latest</th>
                    <th>Example</th>
                  </tr>
                </thead>
                <tbody>
                  {s.reported.map((r) => (
                    <tr>
                      <td>
                        <a href={r.url}>{r.text}</a>
                      </td>
                      <td class="muted">{trackTitle.get(r.topicId.split('/')[0]!)}</td>
                      <td class="num">{r.reports}</td>
                      <td class="num">{r.year}</td>
                      <td>
                        <a class="src" href={r.source} rel="nofollow noopener" target="_blank">
                          report ↗
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )}
      </details>
    ))}
  </div>
</BaseLayout>

<script>
  // A link to a section or a question opens it, along with the section around it.
  const open = () => {
    const el = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (!el) return;
    for (let d: Element | null = el; d; d = d.parentElement?.closest('details') ?? null)
      if (d instanceof HTMLDetailsElement) d.open = true;
    el.scrollIntoView();
  };
  open();
  addEventListener('hashchange', open);
</script>

<style>
  .wrap {
    max-width: 920px;
  }
  .eyebrow a {
    color: inherit;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 560;
    font-size: var(--step-4);
    margin: 0;
  }
  .lede {
    color: var(--ink-2);
    max-width: var(--measure);
  }
  .overview h2,
  .sec h2 {
    font-family: var(--font-serif);
    font-weight: 560;
    font-size: var(--step-2);
    margin: 0;
  }
  .overview {
    margin-top: 16px;
  }
  .overview h2 {
    margin-bottom: 8px;
  }
  .overview ul {
    margin: 0;
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 20px 0 8px;
    padding: 10px 0;
    border-block: 1px solid var(--rule);
    font-size: 0.9375rem;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 24px;
  }
  .jump .n,
  .sec-n {
    color: var(--ink-3);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .sec {
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 72px;
  }
  .sec > summary {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
  }
  .sec > summary::-webkit-details-marker,
  .cq > summary::-webkit-details-marker,
  .sol > summary::-webkit-details-marker {
    display: none;
  }
  .sec > summary::before,
  .sol > summary::before {
    content: '';
    flex: none;
    width: 0.45em;
    height: 0.45em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.15em) rotate(-45deg);
    transition: transform 0.15s;
    color: var(--ink-3);
  }
  .sec[open] > summary::before,
  .sol[open] > summary::before {
    transform: translateY(-0.25em) rotate(45deg);
  }
  .sec[open] > summary {
    padding-bottom: 6px;
  }
  .sec > summary:hover h2 {
    color: var(--accent);
  }
  .sec h3 {
    font-size: 0.9375rem;
    margin: 20px 0 0;
  }
  .sec > :last-child {
    margin-bottom: 16px;
  }
  .cq {
    border-top: 1px solid var(--rule);
    scroll-margin-top: 72px;
  }
  .cq > summary {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 10px 2px;
    cursor: pointer;
    list-style: none;
  }
  .cq > summary:hover .t {
    color: var(--accent);
  }
  .i {
    flex: none;
    min-width: 1.6em;
    color: var(--ink-3);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .t {
    flex: 1;
    min-width: 0;
    font-weight: 560;
  }
  .lede.small {
    font-size: 0.9375rem;
  }
  .lw {
    font-size: 0.8125rem;
    color: var(--ink-3);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 0 5px;
    white-space: nowrap;
  }
  .meta {
    flex: none;
    display: inline-flex;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .d.hard {
    color: var(--bad, var(--ink-2));
  }
  .body {
    padding: 2px 2px 16px;
  }
  .tag {
    margin: 14px 0 4px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-3);
  }
  .io {
    padding: 10px 12px;
    background: var(--code-bg);
    border-radius: 6px;
    font-size: 0.875rem;
    line-height: 1.55;
  }
  .io p {
    margin: 0;
  }
  .io p + p {
    margin-top: 4px;
  }
  .io code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background: none;
    padding: 0;
    overflow-wrap: anywhere;
  }
  .io b {
    font-weight: 600;
  }
  .why {
    color: var(--ink-2);
  }
  .cons {
    margin: 0;
    padding-left: 1.2em;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
  }
  .sol {
    margin-top: 14px;
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  .sol > summary {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 12px;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--accent);
  }
  .sol-body {
    padding: 0 12px 12px;
  }
  .cx {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 12px 0 0;
    font-size: 0.875rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  .tagged {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
  }
  .tagged li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    padding: 6px 0;
    border-bottom: 1px solid var(--rule);
  }
  .scroll {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 8px;
    font-size: 0.9375rem;
  }
  th,
  td {
    padding: 8px 10px;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    white-space: nowrap;
  }
  td:first-child {
    white-space: normal;
    min-width: 200px;
  }
  th {
    font-size: 0.8125rem;
    color: var(--ink-3);
    font-weight: 600;
  }
  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .muted {
    color: var(--ink-3);
    font-size: 0.875rem;
  }
  .src {
    font-size: 0.875rem;
  }
  @media (max-width: 480px) {
    .cq > summary {
      flex-wrap: wrap;
    }
    .t {
      flex-basis: calc(100% - 3em);
    }
    .meta {
      flex: 1 1 calc(100% - 1.6em - 10px);
      flex-wrap: wrap;
      row-gap: 2px;
      margin-left: calc(1.6em + 10px);
    }
  }
</style>
