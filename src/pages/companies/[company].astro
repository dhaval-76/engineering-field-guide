---
import CodeTabs from '~/components/content/CodeTabs.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCompanyIndex, SECTIONS, sectionOfTopic } from '~/lib/companies';
import { md } from '~/lib/markdown';
import { getFlatTopics, getNav } from '~/lib/nav';
import { topicUrl, url } from '~/lib/url';

export async function getStaticPaths() {
  const companies = await getCompanyIndex();
  return companies.map((c) => ({ params: { company: c.slug }, props: { company: c } }));
}

const { company } = Astro.props;
const nav = await getNav();
const trackTitle = new Map(nav.map((n) => [n.track.id, n.track.data.short]));
const titles = new Map((await getFlatTopics()).map((t) => [t.id, t.data.title]));

const overview = await Promise.all(company.overview.map((o) => md(o)));
const questions = await Promise.all(
  company.questions.map(async (q) => ({
    ...q,
    topicId: q.topic.id,
    problemHtml: await md(q.problem),
    solutionHtml: await md(q.solution),
  })),
);
const tagged = await Promise.all(
  company.items
    .filter((i) => i.kind === 'question' || i.kind === 'follow-up')
    .map(async (i) => ({ ...i, answerHtml: i.answer ? await md(i.answer) : '' })),
);
const taggedTopics = company.items.filter((i) => i.kind === 'topic');
const reported = company.items
  .filter((i) => i.kind === 'reported')
  .sort((a, b) => (b.reports ?? 0) - (a.reports ?? 0) || a.text.localeCompare(b.text));

const sections = SECTIONS.map((s) => ({
  ...s,
  // A stable sort, so questions with the same number of reports keep their curated order.
  questions: questions
    .filter((q) => q.section === s.id)
    .sort((a, b) => b.reports.length - a.reports.length),
  tagged: tagged.filter((i) => sectionOfTopic(i.topicId) === s.id),
  taggedTopics: taggedTopics.filter((i) => sectionOfTopic(i.topicId) === s.id),
  reported: reported.filter((i) => sectionOfTopic(i.topicId) === s.id),
})).filter(
  (s) => s.questions.length + s.tagged.length + s.taggedTopics.length + s.reported.length > 0,
);
const count = (s: (typeof sections)[number]) => s.questions.length + s.tagged.length;
---

<BaseLayout
  title={`${company.name} interview questions`}
  description={`Questions reported in ${company.name} interviews by section, with solutions, links to explanations and the original reports.`}
>
  <div class="wrap">
    <p class="eyebrow">
      <a href={url('companies/')}>Companies</a>
    </p>
    <h1>{company.name}</h1>
    <p class="lede">
      {questions.length > 0
        ? 'Questions candidates reported from public interview write-ups, with a solution for each. The most reported come first in every section.'
        : 'Topics and questions candidates mentioned in public interview write-ups.'}{' '}
      Reports show what came up for some candidates, not a fixed question list.
    </p>

    {overview.length > 0 && (
      <section class="overview prose" aria-label="What the rounds look like">
        <h2>What the rounds look like</h2>
        <ul>
          {overview.map((o) => (
            <li set:html={o} />
          ))}
        </ul>
      </section>
    )}

    <nav class="jump" aria-label="Sections">
      {sections.map((s) => (
        <a href={`#${s.id}`}>
          {s.label}
          {count(s) > 0 && <span class="n">{count(s)}</span>}
        </a>
      ))}
    </nav>

    {sections.map((s) => (
      <section class="sec" aria-labelledby={s.id}>
        <h2 id={s.id}>{s.label}</h2>

        {s.questions.map((q, i) => (
          <details class="cq" id={`q-${q.id}`}>
            <summary>
              <span class="i">{i + 1}</span>
              <span class="t">{q.title}</span>
              <span class="meta">
                {q.difficulty && <span class={`d ${q.difficulty}`}>{q.difficulty}</span>}
                {q.reports.length > 1 && <span class="r">{q.reports.length} reports</span>}
              </span>
            </summary>
            <div class="body">
              <div class="prose" set:html={q.problemHtml} />
              <p class="tag">Solution</p>
              <div class="prose" set:html={q.solutionHtml} />
              {q.complexity && (
                <p class="cx">
                  <strong>Cost:</strong> {q.complexity}
                </p>
              )}
              {q.code && <CodeTabs id={q.code} title={q.title} />}
              <p class="links">
                <a href={topicUrl(q.topicId)}>Explained in {titles.get(q.topicId)}</a>
                {q.leetcode && (
                  <a
                    href={`https://leetcode.com/problems/${q.leetcode}/`}
                    rel="nofollow noopener"
                    target="_blank"
                  >
                    Practise on LeetCode ↗
                  </a>
                )}
                {q.reports.map((r, n) => (
                  <a href={r.source} rel="nofollow noopener" target="_blank">
                    Report{q.reports.length > 1 ? ` ${n + 1}` : ''} ({r.year}) ↗
                  </a>
                ))}
              </p>
            </div>
          </details>
        ))}

        {s.tagged.map((it) => (
          <details class="cq">
            <summary>
              <span class="t">{it.text}</span>
            </summary>
            <div class="body">
              <div class="prose" set:html={it.answerHtml} />
              <p class="links">
                <a href={it.url}>Explained in {it.topicTitle}</a>
                <a href={it.source} rel="nofollow noopener" target="_blank">
                  Report{it.year ? ` (${it.year})` : ''} ↗
                </a>
              </p>
            </div>
          </details>
        ))}

        {s.taggedTopics.length > 0 && (
          <ul class="tagged">
            {s.taggedTopics.map((it) => (
              <li>
                <a href={it.url}>{it.text}</a>
                <span class="muted">
                  {it.year && `${it.year} · `}
                  <a href={it.source} rel="nofollow noopener" target="_blank">
                    report ↗
                  </a>
                </span>
              </li>
            ))}
          </ul>
        )}

        {s.reported.length > 0 && (
          <>
            <h3>Topics mentioned in reports</h3>
            <div class="scroll">
              <table>
                <thead>
                  <tr>
                    <th>Topic</th>
                    <th>Track</th>
                    <th class="num">Reports</th>
                    <th class="num">Latest</th>
                    <th>Example</th>
                  </tr>
                </thead>
                <tbody>
                  {s.reported.map((r) => (
                    <tr>
                      <td>
                        <a href={r.url}>{r.text}</a>
                      </td>
                      <td class="muted">{trackTitle.get(r.topicId.split('/')[0]!)}</td>
                      <td class="num">{r.reports}</td>
                      <td class="num">{r.year}</td>
                      <td>
                        <a class="src" href={r.source} rel="nofollow noopener" target="_blank">
                          report ↗
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )}
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  // A link to one question opens it.
  const open = () => {
    const el = location.hash && document.getElementById(location.hash.slice(1));
    if (el instanceof HTMLDetailsElement) el.open = true;
  };
  open();
  addEventListener('hashchange', open);
</script>

<style>
  .wrap {
    max-width: 920px;
  }
  .eyebrow a {
    color: inherit;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 560;
    font-size: var(--step-4);
    margin: 0;
  }
  .lede {
    color: var(--ink-2);
    max-width: var(--measure);
  }
  .overview h2,
  .sec h2 {
    font-family: var(--font-serif);
    font-weight: 560;
    font-size: var(--step-2);
    margin: 0 0 8px;
  }
  .overview {
    margin-top: 16px;
  }
  .overview ul {
    margin: 0;
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 20px 0 8px;
    padding: 10px 0;
    border-block: 1px solid var(--rule);
    font-size: 0.9375rem;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 24px;
  }
  .jump .n {
    color: var(--ink-3);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .sec {
    margin-top: 28px;
    scroll-margin-top: 72px;
  }
  .sec h2 {
    scroll-margin-top: 72px;
  }
  .sec h3 {
    font-size: 0.9375rem;
    margin: 20px 0 0;
  }
  .cq {
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 72px;
  }
  .cq > summary {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 10px 2px;
    cursor: pointer;
    list-style: none;
  }
  .cq > summary::-webkit-details-marker {
    display: none;
  }
  .cq > summary:hover .t {
    color: var(--accent);
  }
  .i {
    flex: none;
    min-width: 1.6em;
    color: var(--ink-3);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .t {
    flex: 1;
    min-width: 0;
    font-weight: 560;
  }
  .meta {
    flex: none;
    display: inline-flex;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .d.hard {
    color: var(--bad, var(--ink-2));
  }
  .body {
    padding: 2px 2px 16px;
  }
  .tag {
    margin: 12px 0 2px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-3);
  }
  .cx {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 12px 0 0;
    font-size: 0.875rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  .tagged {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
  }
  .tagged li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    padding: 6px 0;
    border-bottom: 1px solid var(--rule);
  }
  .scroll {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 8px;
    font-size: 0.9375rem;
  }
  th,
  td {
    padding: 8px 10px;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    white-space: nowrap;
  }
  td:first-child {
    white-space: normal;
    min-width: 200px;
  }
  th {
    font-size: 0.8125rem;
    color: var(--ink-3);
    font-weight: 600;
  }
  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .muted {
    color: var(--ink-3);
    font-size: 0.875rem;
  }
  .src {
    font-size: 0.875rem;
  }
  @media (max-width: 480px) {
    .cq > summary {
      flex-wrap: wrap;
    }
    .t {
      flex-basis: calc(100% - 3em);
    }
    .meta {
      margin-left: calc(1.6em + 10px);
    }
  }
</style>
