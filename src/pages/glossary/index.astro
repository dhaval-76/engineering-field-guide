---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { topicUrl } from '~/lib/url';

const entries = (await getCollection('glossary')).sort((a, b) =>
  a.data.term.localeCompare(b.data.term),
);
const rows = await Promise.all(
  entries.map(async (e) => ({
    ...e,
    topic: e.data.topic ? await getEntry(e.data.topic) : undefined,
  })),
);
const letters = [...new Set(rows.map((r) => r.data.term[0]!.toUpperCase()))];
---

<BaseLayout title="Glossary" description="Short definitions of the terms used across the guide.">
  <div class="wrap">
    <h1>Glossary</h1>
    <p class="lede">
      Short definitions of terms used across the guide. Underlined terms in topics open these
      inline.
    </p>
    <nav class="letters" aria-label="Jump to letter">
      {letters.map((l) => (
        <a href={`#letter-${l}`}>{l}</a>
      ))}
    </nav>
    {letters.map((l) => (
      <section class="letter-group" aria-labelledby={`letter-${l}`}>
        <h2 id={`letter-${l}`}>{l}</h2>
        <dl>
          {rows
            .filter((r) => r.data.term[0]!.toUpperCase() === l)
            .map((r) => (
              <div id={r.id} class="entry">
                <dt>{r.data.term}</dt>
                <dd>
                  {r.data.short}
                  {r.topic && (
                    <>
                      {' '}
                      <a href={topicUrl(r.topic.id)}>{r.topic.data.title} →</a>
                    </>
                  )}
                </dd>
              </div>
            ))}
        </dl>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 760px;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 560;
    font-size: var(--step-4);
    margin: 0;
  }
  .lede {
    color: var(--ink-2);
  }
  .letters {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 16px 0;
  }
  .letters a {
    min-width: 28px;
    padding: 2px 6px;
    text-align: center;
    border: 1px solid var(--rule);
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.875rem;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 560;
    margin: 28px 0 4px;
    color: var(--accent);
  }
  .entry {
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }
  .entry:target {
    background: var(--accent-soft);
  }
  dt {
    font-weight: 650;
  }
  dd {
    margin: 2px 0 0;
    color: var(--ink-2);
  }
</style>
