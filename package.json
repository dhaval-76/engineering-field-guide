{
  "name": "engineering-field-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && tsx scripts/pwa/build-sw.ts",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "new:topic": "tsx scripts/new-topic.ts",
    "check:content": "tsx scripts/check-content.ts",
    "diagrams": "tsx scripts/render-diagrams.ts",
    "report:migration": "tsx scripts/migration-report.ts",
    "research:fetch": "tsx scripts/research/leetcode-discuss.ts",
    "research:analyze": "tsx scripts/research/analyze.ts",
    "research:apply": "tsx scripts/research/apply-reports.ts",
    "og": "tsx scripts/og-images.ts",
    "icons": "tsx scripts/pwa/icons.ts",
    "audit:mobile": "tsx scripts/audit/mobile.ts",
    "audit:offline": "tsx scripts/audit/offline.ts",
    "test:offline-update": "tsx scripts/audit/offline-update.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^1.7.0",
    "marked": "^18.1.2",
    "mermaid-isomorphic": "^3.1.0",
    "pagefind": "^1.5.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "yaml": "^2.9.1"
  }
}
